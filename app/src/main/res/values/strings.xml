    <string name="about_section_brailux">Sobre Brailux</string>
    <string name="about_brailux_description">Brailux es una aplicación educativa de NeuroNova Apps orientada a conocer, comprender y practicar los fundamentos del sistema Braille mediante una experiencia accesible e interactiva.</string>
    <string name="about_section_purpose">Propósito</string>
    <string name="about_purpose_description">Brailux funciona como un recurso introductorio y complementario para comprender la celda Braille, la formación de caracteres y algunos principios de lectura y escritura. No sustituye la alfabetización Braille formal, los materiales táctiles ni la enseñanza especializada.</string>
    <string name="about_section_features">Características</string>
    <string name="about_list_item">• %1$s</string>
    <string-array name="about_features">
        <item>Aprendizaje de la celda Braille de seis puntos.</item>
        <item>Lecciones guiadas.</item>
        <item>Reconocimiento de letras y caracteres.</item>
        <item>Práctica de lectura.</item>
        <item>Sesiones de práctica configurables.</item>
        <item>Pistas y ayudas.</item>
        <item>Práctica diaria.</item>
        <item>Seguimiento local del progreso.</item>
        <item>XP, constancia y logros.</item>
        <item>Funcionamiento sin conexión.</item>
    </string-array>
    <string name="about_section_accessibility">Accesibilidad y personalización</string>
    <string-array name="about_accessibility_features">
        <item>Compatibilidad con TalkBack.</item>
        <item>Alto contraste.</item>
        <item>Tamaños de texto.</item>
        <item>Modo claro.</item>
        <item>Modo oscuro.</item>
        <item>Adaptación al sistema.</item>
        <item>Sonido configurable.</item>
        <item>Vibración configurable.</item>
        <item>Controles con áreas táctiles adecuadas.</item>
        <item>Estados que no dependen únicamente del color.</item>
    </string-array>
