    <string name="vowel_a_explanation">La A es el primer patrón: utiliza solamente el punto superior izquierdo.</string>
    <string name="vowel_e_explanation">La E conserva el punto 1 de la A y añade el punto 5.</string>
    <string name="vowel_i_explanation">La I usa dos columnas: el punto 2 a la izquierda y el 4 a la derecha.</string>
    <string name="vowel_o_explanation">La O combina los puntos 1 y 3 de la izquierda con el punto 5 de la derecha.</string>
    <string name="vowel_u_explanation">La U combina los puntos 1 y 3 con el punto inferior derecho, el 6.</string>
    <string name="letter_a_comparison">La A es la base del grupo y utiliza solo el punto 1.</string>
    <string name="letter_b_comparison">La B parte de la A y añade el punto 2 debajo.</string>
    <string name="letter_c_comparison">La C mantiene el punto 1 de la A y añade el punto 4 en la columna derecha.</string>
    <string name="letter_d_comparison">La D parte de la C y añade el punto 5.</string>
    <string name="letter_e_comparison">La E se parece a la D, pero no utiliza el punto 4.</string>
    <string name="letter_f_comparison">La F combina la columna izquierda de la B con el punto 4.</string>
    <string name="letter_g_comparison">La G parte de la F y añade el punto 5.</string>
    <string name="letter_h_comparison">La H se parece a la G, pero no utiliza el punto 4.</string>
    <string name="letter_i_comparison">La I usa los puntos 2 y 4, uno en cada columna.</string>
    <string name="letter_j_comparison">La J parte de la I y añade el punto 5.</string>
    <string name="letter_k_comparison">La K parte de la A y añade el punto 3.</string>
    <string name="letter_l_comparison">La L parte de la B y añade el punto 3.</string>
    <string name="letter_m_comparison">La M parte de la C y añade el punto 3.</string>
    <string name="letter_n_comparison">La N parte de la D y añade el punto 3.</string>
    <string name="letter_o_comparison">La O parte de la E y añade el punto 3.</string>
    <string name="letter_p_comparison">La P parte de la F y añade el punto 3.</string>
    <string name="letter_q_comparison">La Q parte de la G y añade el punto 3.</string>
    <string name="letter_r_comparison">La R parte de la H y añade el punto 3.</string>
    <string name="letter_s_comparison">La S parte de la I y añade el punto 3.</string>
    <string name="letter_t_comparison">La T parte de la J y añade el punto 3.</string>
    <string name="letter_u_comparison">La U parte de la K y añade el punto 6.</string>
    <string name="letter_v_comparison">La V parte de la L y añade el punto 6.</string>
    <string name="letter_w_comparison">La W es un patrón especial: usa 2, 4, 5 y 6.</string>
    <string name="letter_x_comparison">La X parte de la M y añade el punto 6.</string>
    <string name="letter_y_comparison">La Y parte de la N y añade el punto 6.</string>
    <string name="letter_z_comparison">La Z parte de la O y añade el punto 6.</string>
    <string name="letter_enye_comparison">La Ñ usa los puntos 1, 2, 4, 5 y 6.</string>

