# Archivo de ejemplo para configuracion de firma en Release
# IMPORTANTE: No colocar contrasenas reales en este archivo ni versionar credenciales.
# Copiar este archivo como keystore.properties en la raiz del proyecto y completar los valores requeridos.
# NOTA: En archivos .properties, las rutas de Windows pueden usar barras normales '/' o barras invertidas dobles '\\'.

storeFile=C:/Users/PC/NeuroNovaKeys/Brailux/brailux-upload-key.jks
storePassword=TU_KEYSTORE_PASSWORD
keyAlias=brailux-upload-key
keyPassword=TU_KEY_PASSWORD
